{
  "manifest_version": 3,
  "name": "Timmy Network Sync",
  "version": "1.0.0",
  "author": "Timmy.Huang",
  "description": "实时捕获并在 popup 中展示当前页面的网络请求",
  "permissions": ["tabs", "storage", "windows", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Network Sync"
  },
  "web_accessible_resources": [
    { "resources": ["interceptor.js"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
